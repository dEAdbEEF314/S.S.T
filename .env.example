# ==============================================================================
# S.S.T (Steam Soundtrack Tagger) 統合設定ファイル (.env.example)
# ==============================================================================

# ==============================================================================
# 1. Steam 連携設定 (Steam Integration Settings)
# ==============================================================================
# 【必須】Steamのインストールディレクトリ、またはそれをマウントしたパス
# Steam本体のファイル（config/loginusers.vdf など）が存在するディレクトリを指定してください。
STEAM_INSTALL_PATH=/path/to/Steam

# 【オプション】Steamのライブラリディレクトリ、またはそれをマウントしたパス
# 特定のライブラリのみをスキャンしたい場合のみ指定。指定がない場合、libraryfolders.vdf を自動解析して全ライブラリをスキャンします。
STEAM_LIBRARY_PATH=

# Steam dynamicstore からuserdata.json を自動取得するためのクッキー値
# ブラウザの開発者ツール(F12) → Application → Cookies → store.steampowered.com
# → "steamLoginSecure" の Value をコピーして貼り付ける
STEAM_LOGIN_SECURE=your_steam_login_secure_cookie_here

# Steam Web API Key (API呼び出しを強化する場合に使用)
STEAM_WEB_API_KEY=your_steam_web_api_key_here

# Steam PICS Bridge URL (外部サーバーまたはローカルDocker)
STEAM_PICS_BRIDGE_URL=http://localhost:8080/v1/info/

# Steam PICS Bridge API Key (外部サーバーで認証が必要な場合のみ指定)
STEAM_PICS_BRIDGE_API_KEY=your_pics_bridge_api_key_here


# ==============================================================================
# 2. ローカル処理・システム設定 (Local Processing & System)
# ==============================================================================
# 処理済みファイルの出力先ディレクトリ
# 指定したディレクトリ内に archive/ と review/ フォルダが作成され、ZIPアーカイブが出力されます。
SST_OUTPUT_DIR=./output

# 変換やタグ付け作業を行うための一時ディレクトリ (ローカルの高速な領域を推奨)
SST_WORKING_DIR=/tmp/sst-work

# 処理状態を記録するSQLiteデータベースのパス
SST_DB_PATH=data/sst_local_state.db

# 並列処理設定 (FFmpeg変換などの音声処理の同時実行数)
MAX_ENCODING_TASKS=4

# システム設定
USER_LANGUAGE=ja
# Steam公式ページからタグ名称を再検証する間隔（日）
STEAM_TAG_CACHE_REFRESH_DAYS=30
LOG_LEVEL=INFO
TZ=Asia/Tokyo


# ==============================================================================
# 3. LLM 基本設定 (LLM Configuration)
# ==============================================================================
# LLM バックエンド設定 (OLLAMA | GEMINI | OPENAI_COMPATIBLE)
LLM_BACKEND=OLLAMA

# ベースURL
# Ollama: http://localhost:11434 / Gemini: https://generativelanguage.googleapis.com
LLM_BASE_URL=http://localhost:11434

# APIキー (Ollamaの場合はダミーで可)
LLM_API_KEY=your_llm_api_key_here

# ローカル Ollama 運用の推奨モデルは ornith:9b です。
LLM_MODEL=ornith:9b

# 全体並列処理（Cloud API では同時アルバム数の床、Ollama では runner 側の上限）
MAX_PARALLEL_ALBUMS=2


# ==============================================================================
# 4. LLM チューニング・レート制限 (LLM Chunking & Limits)
# ==============================================================================
# --- クラウドAPI制限 ---
LLM_LIMIT_RPM=15
LLM_LIMIT_TPM=10000000
LLM_LIMIT_RPD=1500
LLM_CLOUD_MAX_TOKENS=8192

# --- Ollama コンテキスト・並列制御 ---
# 1リクエストで参照可能な最大コンテキストトークン
LLM_OLLAMA_NUM_CTX=16384
# 設定上の最大出力トークン。実際の num_predict はリクエスト種別・曲数から有限値として計算されます。
LLM_OLLAMA_NUM_PREDICT=4096
# llama-server / Ollama の実効 sequence slot 数（例: llama-server -np 4）。
# SST のアルバムworker数はVRAM算出値とこの値の小さい方に制限されます。
LLM_OLLAMA_PARALLEL_SLOTS=4
# VRAMスケジューリングとリクエスト並列化
LLM_VRAM_SCHEDULING_ENABLED=true
LLM_REQUEST_PARALLELISM_ENABLED=true
LLM_REQUEST_PARALLELISM_MAX_WORKERS=2

# アライメントはSTEAMスロットとローカルシグナルを直接処理します。
# --- Album Tier別の上書き設定 ---
# 未設定の tier は上記の LLM_OLLAMA_NUM_CTX / LLM_REQUEST_PARALLELISM_MAX_WORKERS をそのまま使います。
# Small: throughput 優先 / Medium: バランス / Large: 一貫性優先
LLM_ALBUM_TIER_SMALL_MAX_TRACKS=50
LLM_ALBUM_TIER_MEDIUM_MAX_TRACKS=100
LLM_OLLAMA_NUM_CTX_SMALL=8192
LLM_OLLAMA_NUM_CTX_MEDIUM=16384
LLM_OLLAMA_NUM_CTX_LARGE=32768
LLM_REQUEST_PARALLELISM_MAX_WORKERS_SMALL=3
LLM_REQUEST_PARALLELISM_MAX_WORKERS_MEDIUM=2
LLM_REQUEST_PARALLELISM_MAX_WORKERS_LARGE=1
LLM_FORCE_COHERENCE_LARGE=true

# --- チャンク・Coherence 制御 ---
LLM_COHERENCE_THRESHOLD=75
LLM_CHUNK_SIZE_VIRTUAL=20
LLM_CHUNK_SIZE_METADATA_OLLAMA=10
LLM_CHUNK_SIZE_METADATA_CLOUD=30
LLM_CHUNK_ADAPTIVE=true
LLM_CHUNK_OUTPUT_TOKENS_PER_TRACK=180
LLM_CHUNK_OUTPUT_SAFETY_RATIO=0.75


# ==============================================================================
# 5. 外部メタデータAPI連携 (External Metadata API)
# ==============================================================================
# MusicBrainz 問い合わせ時の User-Agent 情報
MBZ_APP_NAME=SST-Scout
MBZ_APP_VERSION=1.0.0
MBZ_CONTACT=your_email@example.com

# AcoustID API Client Key (音声指紋による楽曲特定に使用)
ACOUSTID_API_KEY=your_acoustid_api_key_here


# ==============================================================================
# 6. MusicBrainz スコアリング設定 (NWO Hybrid Scoring)
# ==============================================================================
SCORE_MBZ_DIRECT_STEAM_LINK=500
SCORE_MBZ_PARENT_STEAM_LINK=300
SCORE_MBZ_DIRECT_STEAMDB_LINK=500
SCORE_MBZ_PARENT_STEAMDB_LINK=300
SCORE_MBZ_BANDCAMP_LINK=100
SCORE_MBZ_TITLE_SIMILARITY_MAX=100
SCORE_MBZ_TRACK_COUNT_MATCH=50
SCORE_MBZ_TRACK_COUNT_PENALTY_PER_TRACK=20
SCORE_MBZ_TRACK_COUNT_PENALTY_MAX=300
SCORE_MBZ_DIGITAL_FORMAT=30
SCORE_MBZ_DATE_MATCH=20
SCORE_MBZ_DATE_PENALTY_PER_YEAR=20
SCORE_MBZ_DATE_PENALTY_MAX=100
SCORE_MBZ_FINGERPRINT_MATCH=200
SCORE_MBZ_DIRECT_RECORDING_MATCH=1000
SCORE_MBZ_ACOUSTID_RELEASE_MATCH=1000
SCORE_MBZ_PUBLISHER_LABEL_MATCH=100
MIN_MBZ_SEARCH_SCORE_THRESHOLD=250


# ==============================================================================
# 7. Discord 通知設定 (Discord Notifications)
# ==============================================================================
NOTIFY_ENABLED=false
NOTIFY_COOLDOWN=60
DISCORD_WEBHOOK_CRITICAL=https://discord.com/api/webhooks/your_critical_webhook_here
DISCORD_WEBHOOK_WARNING=https://discord.com/api/webhooks/your_warning_webhook_here
DISCORD_WEBHOOK_INFO=https://discord.com/api/webhooks/your_info_webhook_here
DISCORD_WEBHOOK_COMPLETION=https://discord.com/api/webhooks/your_completion_webhook_here
